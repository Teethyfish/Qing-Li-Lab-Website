# PostgreSQL/Supabase
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@DATABASE_HOST:5432/postgres"

# Authentication and public deployment URL
NEXTAUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email (SMTP fallback)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Qing Li Lab <noreply@example.com>"

# Optional: preferred production email provider
RESEND_API_KEY=""
RESEND_FROM="Qing Li Lab <noreply@example.com>"

# Google Drive document storage + Gmail notifications (OAuth 2.0 web client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
GOOGLE_ACCOUNT_EMAIL="qinglilab@gmail.com"
GOOGLE_DRIVE_FOLDER_ID=""
# Use a separate long random value in production; falls back to NEXTAUTH_SECRET.
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Protects the scheduled reminder endpoint. Set the same long random value in Vercel.
CRON_SECRET="replace-with-a-long-random-value"
