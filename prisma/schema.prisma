// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled
  directUrl = env("DIRECT_URL") // direct for migrate/generate
}

enum Role {
  ADMIN
  PI
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  ALUMNI
  INACTIVE
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  role               Role                @default(MEMBER)
  passwordHash       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  about              String?
  slug               String?             @unique
  imageUrl           String?
  locale             String              @default("en")
  themePreference    String              @default("light")
  mustResetPassword  Boolean             @default(false)
  isActive           Boolean             @default(true)
  membershipStatus   MembershipStatus    @default(ACTIVE)
  profileContent     Json?
  documentsCreated   LabDocument[]       @relation("DocumentCreator")
  documentRecipients DocumentRecipient[]
  notifications      Notification[]
  noteWorkspace      NoteWorkspace?
  reminders          Reminder[]
  announcementReads  AnnouncementRead[]
}

model AppConfig {
  key   String @id
  value String
}

model PendingInvite {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  slug        String       @unique // desired public URL part, e.g. "lynn-zhang"
  note        String? // optional message from the requester
  status      InviteStatus @default(PENDING)
  requestedAt DateTime     @default(now())
  decidedAt   DateTime? // when approved/denied
  decidedById String? // User.id of the approver (ADMIN or PI)
}

enum InviteStatus {
  PENDING
  APPROVED
  DENIED
}

enum AnnouncementStatus {
  ACTIVE
  ARCHIVED
}

model Announcement {
  id             String             @id @default(cuid())
  imageUrl       String // URL to the banner image
  title          String             @default("{\"en\":\"\"}") // JSON object storing title translations {en: string, zh?: string, ko?: string}
  text           String // JSON object storing subtitle translations {en: string, zh?: string, ko?: string}
  croppedArea    String? // JSON string storing crop coordinates {x, y, width, height}
  order          Int                @default(0) // Display order (lower numbers first)
  status         AnnouncementStatus @default(ACTIVE) // ACTIVE shows on homepage, ARCHIVED keeps details page only
  hasDetailsPage Boolean            @default(false) // Whether this announcement has a details page
  detailsSlug    String?            @unique // URL slug for details page (e.g., "summer-symposium-2024")
  detailsContent String? // JSON object storing detailed content translations
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  reads          AnnouncementRead[]
}

model AnnouncementRead {
  userId         String
  announcementId String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@index([announcementId])
}

model LabDocument {
  id            String              @id @default(cuid())
  title         String
  description   String
  emailSubject  String
  fileName      String
  mimeType      String
  sizeBytes     Int
  driveFileId   String              @unique
  isPublic      Boolean             @default(false)
  createdById   String?
  createdBy     User?               @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recipients    DocumentRecipient[]
  notifications Notification[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([isPublic, createdAt])
}

model DocumentRecipient {
  documentId   String
  userId       String
  notifiedAt   DateTime?
  downloadedAt DateTime?
  document     LabDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
}

model Notification {
  id         String       @id @default(cuid())
  userId     String
  documentId String?
  title      String
  message    String
  href       String
  readAt     DateTime?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   LabDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model GoogleConnection {
  id                    String   @id @default("google")
  email                 String
  encryptedRefreshToken String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Instrument {
  id          String   @id @default(cuid())
  name        String
  description String
  location    String
  imageUrl    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model InstrumentAccessRequest {
  id                    String   @id @default(cuid())
  name                  String
  department            String
  supervisor            String?
  email                 String
  requestedInstruments  String
  experimentDescription String
  trainingRequired      Boolean
  status                String   @default("NEW")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([createdAt])
  @@index([email, createdAt])
}

model NoteWorkspace {
  userId    String   @id
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id        String    @id @default(cuid())
  userId    String
  message   String
  remindAt  DateTime
  emailedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
  @@index([emailedAt, remindAt])
}
